    "seed": "node src/db/seed.js"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "fastify": "^5.2.0",
    "mysql2": "^3.12.0"
  }
}
