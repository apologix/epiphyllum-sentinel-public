{
  "name": "canario-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Outsourcing Canario — API REST (Fastify + MySQL). Logs NDJSON compatibles con node-json@1 de Epiphyllum Sentinel.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
