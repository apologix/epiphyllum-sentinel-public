[Unit]
Description=Outsourcing Canario API (laboratorio Epiphyllum)
After=network.target mysql.service
Wants=mysql.service

[Service]
Type=simple
User=canario
Group=canario
WorkingDirectory=/srv/outsourcing-canario/backend
ExecStart=/usr/bin/node src/server.js
Restart=on-failure
RestartSec=3
EnvironmentFile=/etc/canario/canario.env
# El generador de version.json de lab/vm-version reutiliza esta unidad:
# instalar su drop-in con EPIPHYLLUM_UNIT=canario-api (ver docs/10).
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/epiphyllum-lab/logs/node /var/lib/canario

[Install]
WantedBy=multi-user.target
