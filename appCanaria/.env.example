# Copiar a /etc/canario/canario.env en la VM y completar. NUNCA commitear el real.
CANARIA_PORT=3001
CANARIA_HOST=127.0.0.1
CANARIA_LAB_MODE=safe
# CANARIA_LAB_ISOLATED=1
# CANARIA_LAB_ALLOWED_CIDR=192.168.122.0/24
CANARIA_LOG_DIR=/var/lib/epiphyllum-lab/logs/node
CANARIA_SESSION_SECRET=CAMBIAR-EN-LA-VM
CANARIA_DB_HOST=127.0.0.1
CANARIA_DB_PORT=3306
CANARIA_DB_NAME=canario
CANARIA_DB_USER=canario_app
CANARIA_DB_PASSWORD=CAMBIAR-EN-LA-VM
CANARIA_DB_LAB_USER=canario_lab_ro
CANARIA_DB_LAB_PASSWORD=CAMBIAR-EN-LA-VM
CANARIA_DEMO_PASSWORD=CAMBIAR-EN-LA-VM
CANARIA_ADMIN_PASSWORD=CAMBIAR-EN-LA-VM
CANARIA_LAB_FILES_DIR=/srv/outsourcing-canario/lab-files
CANARIA_OUTBOX_DIR=/var/lib/canario/outbox
