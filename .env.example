# Opcional. Una copia nueva no necesita .env ni setup.sh.
# Docker genera secretos únicos en private-secrets. Conservar valores existentes al migrar.
ADMIN_SECRET=
MASTER_KEY=
DEMO_SESSION_ID=00000000-0000-4000-8000-000000000042
# Solo para compatibles revisados por operador: URL base HTTPS exacta, separadas por coma.
PROVIDER_ALLOWED_ORIGINS=
